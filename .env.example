# Copia este archivo como .env y ajusta los valores si lo necesitas:
#   cp .env.example .env

# Puerto donde corre la API
PORT=3000

# Conexión a PostgreSQL (los mismos valores los usa docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password-ficticia
DB_NAME=reservas

# API Keys válidas separadas por comas (una por sede). Son claves ficticias:
# no las uses como credenciales reales.
API_KEYS=clave-ficticia-sede-norte,clave-ficticia-sede-malecon
